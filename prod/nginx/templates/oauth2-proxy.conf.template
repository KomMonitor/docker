resolver 127.0.0.11 valid=30s ipv6=off;

server {
    listen            ${NGINX_PORT} ssl;
    listen       [::]:${NGINX_PORT} ssl;
    ssl_certificate /etc/ssl/cert.pem;
    ssl_certificate_key /etc/ssl/key.pem;

    client_max_body_size 1G;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Nginx-Proxy true;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_buffer_size          128k;
    proxy_buffers              4 256k;
    proxy_busy_buffers_size    256k;

    location /kommonitor/api {
        location /kommonitor/api/importer/ {
            set $upstream_importer ${IMPORTER};
            proxy_pass http://$upstream_importer/;
        }
        location /kommonitor/api/client-config/ {
            set $upstream_client_config ${CLIENT_CONFIG};
            proxy_pass http://$upstream_client_config/;
        }
        location /kommonitor/api/datamanagement/ {
            set $upstream_data_management ${DATA_MANAGEMENT};
            proxy_pass http://$upstream_data_management/;
        }
        location /kommonitor/api/processor/ {
            set $upstream_spatial_data_processor ${SPATIAL_DATA_PROCESSOR};
            proxy_pass http://$upstream_spatial_data_processor/;
        }
        location /kommonitor/api/processes/ {
            set $upstream_processes_api ${PROCESSES_API};
            proxy_pass http://$upstream_processes_api/;
        }
    }

    location /kommonitor/ {
        set $upstream_client ${CLIENT};
        proxy_pass http://$upstream_client/;
    }

    location = /prefect/oauth2/auth {
        proxy_pass http://oauth2-proxy:4180;

        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
    }

    location /prefect/oauth2/ {
        proxy_pass http://oauth2-proxy:4180;

        proxy_set_header X-Auth-Request-Redirect $request_uri;
    }

    location /prefect/ {
        auth_request /prefect/oauth2/auth;
        error_page 401 = /prefect/oauth2/sign_in?rd=$scheme://$host$request_uri;

        set $upstream_prefect ${PREFECT_SERVER};
        proxy_pass http://$upstream_prefect;
    }

}
